PORT=3000
CLIENT_ORIGIN=http://localhost:4200
# On-disk home for gallery media, one folder per category.
# Defaults to <repo>/storage/media, which on the VPS is a symlink into
# /var/www/demori/data/storage/media. Set only to override.
# MEDIA_DIR=/var/www/demori/data/storage/media
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=owner@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('choose-a-strong-password', 12))"
ADMIN_PASSWORD_HASH=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
CONTACT_TO_EMAIL=owner@example.com
CONTACT_FROM_EMAIL=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user@example.com
SMTP_PASS=replace-with-smtp-password
GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-folder-id
# One-line JSON from a Google Cloud service account. Share the Drive folder with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
GOOGLE_MEDIA_FOLDER_ID=your-private-media-folder-id
GOOGLE_MEDIA_TOKEN_TTL=12h

# --- Cloudflare R2 (gallery media hosting) ---
# Credentials come from an R2 API token scoped to this bucket only.
# Leave blank to list and serve gallery media from local disk instead.
# With these set and MEDIA_CDN_URL below filled in, the gallery is listed from
# the bucket and loaded from it too, so a machine needs no local copy of the
# photos at all.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=demori-media
# Public base URL for the bucket, no trailing slash. Setting this is what
# switches the gallery over to the CDN: `npm run manifest` then builds the
# gallery listing from the bucket and hands the app this URL (via the generated
# src/assets/media-config.json) so it loads media straight from R2. Until then
# media is listed and served locally.
# Use a custom domain bound to the bucket -- the r2.dev URL is rate limited
# and not intended for production traffic.
# NOTE: this is NOT the <account>.r2.cloudflarestorage.com S3 endpoint -- that one
# requires signed requests and will reject public reads. Use a custom domain bound
# to the bucket, e.g. https://media.demori.studio
MEDIA_CDN_URL=
