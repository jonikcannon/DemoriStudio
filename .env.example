PORT=3000
CLIENT_ORIGIN=http://localhost:4200
# On-disk home for gallery media, one folder per category.
# Defaults to <repo>/storage/media, which on the VPS is a symlink into
# /var/www/demori/data/storage/media. Set only to override.
# MEDIA_DIR=/var/www/demori/data/storage/media
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=owner@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('choose-a-strong-password', 12))"
ADMIN_PASSWORD_HASH=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
CONTACT_TO_EMAIL=owner@example.com
CONTACT_FROM_EMAIL=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user@example.com
SMTP_PASS=replace-with-smtp-password
GOOGLE_DRIVE_FOLDER_ID=your-shared-drive-folder-id
# One-line JSON from a Google Cloud service account. Share the Drive folder with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
GOOGLE_MEDIA_FOLDER_ID=your-private-media-folder-id
GOOGLE_MEDIA_TOKEN_TTL=12h
